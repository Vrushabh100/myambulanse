# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/myambulance
# Long random secret used to sign JWTs (required in production)
JWT_SECRET=replace-with-a-long-random-secret
PORT=5050
# 32-byte key (base64 or 64-hex) for encrypting each user's default (owner-only) MPIN
DEFAULT_MPIN_ENC_KEY=replace-with-32-byte-base64-or-hex-key
# Long random key for the owner-only recovery admin API (x-admin-key header)
ADMIN_API_KEY=replace-with-a-long-random-secret
# Seconds a user must wait after 5/10 wrong MPIN or answer attempts (default 60)
MPIN_LOCK_SECONDS=60
# Set to 1 only when behind a trusted proxy (Vercel/Render) so X-Forwarded-For is honored
TRUST_PROXY=1
# Optional: extra origin allowed in CSP connect-src when client and API are on different origins
# CSP_CONNECT_SRC=https://your-api.example.com
# Comma-separated browser origins allowed to call the API (same-origin deployments can leave this unset)
CORS_ORIGINS=
# production | development
NODE_ENV=
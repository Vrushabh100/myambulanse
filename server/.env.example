# REQUIRED: MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/db)
MONGODB_URI=
JWT_SECRET=
PORT=5050
# Set to 1 only when running behind a trusted reverse proxy (e.g. Render) so X-Forwarded-For is honored
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API (same-origin deployments can leave this unset)
CORS_ORIGINS=
# production | development
NODE_ENV=